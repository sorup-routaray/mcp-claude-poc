# Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Secrets / local config
.env
.env.*
!.env.example

# Test, lint and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs and temporary files
*.log
*.tmp
