# Claude Code: personal settings (shared .claude/settings.json stays tracked)
.claude/settings.local.json

# Node (MCP Inspector via npx, if a local install is ever made)
node_modules/

# IDEs / editors
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini
