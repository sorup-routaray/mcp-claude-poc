# Copy to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL="claude-haiku-5-5"
# Thinking counts toward this limit; keep it >= 16000
MAX_TOKENS=16000
# Optional: low | medium | high | xhigh | max
# CLAUDE_EFFORT=medium
# 1 = launch MCP servers with `uv run`, 0 = use the current Python interpreter
USE_UV=1
# 1 = log every Claude API and MCP server request/response to a file, 0 = off
# The log contains full conversation content: treat it as sensitive.
CALL_LOG_ENABLED=0
# CALL_LOG_FILE=logs/calls.log
# CALL_LOG_MAX_BYTES=10485760
# CALL_LOG_BACKUP_COUNT=5
