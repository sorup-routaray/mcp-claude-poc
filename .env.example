# Copy to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL="claude-opus-5-5"
# Thinking counts toward this limit; keep it >= 16000
MAX_TOKENS=16000
# Optional: low | medium | high | xhigh | max
# CLAUDE_EFFORT=medium
# 1 = launch MCP servers with `uv run`, 0 = use the current Python interpreter
USE_UV=1
